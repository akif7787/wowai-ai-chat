# BAILU AI API Configuration
# BAILU provides an OpenAI-compatible API at https://bailucode.com/openapi
BAILU_API_KEY=your_bailu_api_key_here
BAILU_MODEL=your_model_name_here

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_API_KEY: Optional alias for AI provider key
AI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"


